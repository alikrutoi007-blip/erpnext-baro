{
  "doctype": "Repair Job",
  "module": "CRM",
  "description": "Central Baro Service workflow record connecting call, customer, equipment, diagnostics, technician, estimate, repair, invoice, payment, and warranty.",
  "naming_series": "RJ-.YYYY.-",
  "mvp_statuses": [
    "New",
    "Need Follow-up",
    "Diagnostics Offered",
    "Waiting Prepayment",
    "Diagnostics Paid",
    "Technician Assigned",
    "Diagnostics In Progress",
    "Diagnosis Completed",
    "Estimate Sent",
    "Waiting Client Approval",
    "Parts Needed",
    "Repair In Progress",
    "Repair Completed",
    "Invoice Sent",
    "Paid",
    "Warranty Active",
    "Closed",
    "Lost",
    "Spam",
    "Unrelated"
  ],
  "fields": [
    {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "New\nNeed Follow-up\nDiagnostics Offered\nWaiting Prepayment\nDiagnostics Paid\nTechnician Assigned\nDiagnostics In Progress\nDiagnosis Completed\nEstimate Sent\nWaiting Client Approval\nParts Needed\nRepair In Progress\nRepair Completed\nInvoice Sent\nPaid\nWarranty Active\nClosed\nLost\nSpam\nUnrelated", "required": true, "default": "New"},
    {"fieldname": "customer", "label": "Customer", "fieldtype": "Link", "options": "Customer", "required": true},
    {"fieldname": "contact", "label": "Contact", "fieldtype": "Link", "options": "Contact"},
    {"fieldname": "service_address", "label": "Service Address", "fieldtype": "Link", "options": "Address"},
    {"fieldname": "caller_phone", "label": "Caller Phone", "fieldtype": "Data", "options": "Phone"},
    {"fieldname": "business_phone_did", "label": "Business Phone DID", "fieldtype": "Data", "options": "Phone"},
    {"fieldname": "area", "label": "Area", "fieldtype": "Data"},
    {"fieldname": "marketing_source", "label": "Marketing Source", "fieldtype": "Data"},
    {"fieldname": "zadarma_recording_url", "label": "Zadarma Recording URL", "fieldtype": "Small Text"},
    {"fieldname": "zadarma_call_id", "label": "Zadarma Call ID", "fieldtype": "Data", "unique": true},
    {"fieldname": "call_datetime", "label": "Call Datetime", "fieldtype": "Datetime"},
    {"fieldname": "call_duration_seconds", "label": "Call Duration Seconds", "fieldtype": "Int"},
    {"fieldname": "call_transcript", "label": "Call Transcript", "fieldtype": "Long Text"},
    {"fieldname": "ai_call_summary", "label": "AI Call Summary", "fieldtype": "Small Text"},
    {"fieldname": "call_quality", "label": "Call Quality", "fieldtype": "Small Text"},
    {"fieldname": "purpose_of_call", "label": "Purpose Of Call", "fieldtype": "Small Text"},
    {"fieldname": "client_information_from_call", "label": "Client Information From Call", "fieldtype": "Small Text"},
    {"fieldname": "service_summary", "label": "Service Summary", "fieldtype": "Small Text"},
    {"fieldname": "equipment_type", "label": "Equipment Type", "fieldtype": "Data"},
    {"fieldname": "equipment_brand", "label": "Equipment Brand", "fieldtype": "Data"},
    {"fieldname": "equipment_model", "label": "Equipment Model", "fieldtype": "Data"},
    {"fieldname": "symptom", "label": "Symptom", "fieldtype": "Small Text"},
    {"fieldname": "urgency", "label": "Urgency", "fieldtype": "Select", "options": "\nEmergency\nToday\nThis Week\nScheduled\nUnknown"},
    {"fieldname": "diagnostic_price", "label": "Diagnostic Price", "fieldtype": "Currency"},
    {"fieldname": "prepayment_status", "label": "Prepayment Status", "fieldtype": "Select", "options": "\nNot Requested\nRequested\nPaid\nFailed\nRefunded\nWaived"},
    {"fieldname": "assigned_dispatcher", "label": "Assigned Dispatcher", "fieldtype": "Link", "options": "User"},
    {"fieldname": "estimate_manager", "label": "Estimate Manager", "fieldtype": "Link", "options": "User"},
    {"fieldname": "production_manager", "label": "Production Manager", "fieldtype": "Link", "options": "User"},
    {"fieldname": "technician", "label": "Technician", "fieldtype": "Link", "options": "Employee"},
    {"fieldname": "mentor", "label": "Mentor", "fieldtype": "Link", "options": "Employee"},
    {"fieldname": "client_group_name", "label": "Client Group Name", "fieldtype": "Data"},
    {"fieldname": "client_group_project", "label": "Client Group Project", "fieldtype": "Link", "options": "Project"},
    {"fieldname": "client_group_created_at", "label": "Client Group Created At", "fieldtype": "Datetime"},
    {"fieldname": "client_group_members", "label": "Client Group Members", "fieldtype": "Small Text"},
    {"fieldname": "diagnosis_result", "label": "Diagnosis Result", "fieldtype": "Long Text"},
    {"fieldname": "estimate_amount", "label": "Estimate Amount", "fieldtype": "Currency"},
    {"fieldname": "client_approval_status", "label": "Client Approval Status", "fieldtype": "Select", "options": "\nNot Sent\nSent\nApproved\nRejected\nNeed Follow-up"},
    {"fieldname": "parts_needed", "label": "Parts Needed", "fieldtype": "Check"},
    {"fieldname": "parts_status", "label": "Parts Status", "fieldtype": "Select", "options": "\nNot Needed\nNeed Identify\nOrdered\nReceived\nInstalled"},
    {"fieldname": "repair_result", "label": "Repair Result", "fieldtype": "Long Text"},
    {"fieldname": "warranty_start_date", "label": "Warranty Start Date", "fieldtype": "Date"},
    {"fieldname": "warranty_end_date", "label": "Warranty End Date", "fieldtype": "Date"},
    {"fieldname": "next_follow_up_datetime", "label": "Next Follow Up Datetime", "fieldtype": "Datetime"},
    {"fieldname": "internal_comment", "label": "Internal Comment", "fieldtype": "Long Text"}
  ]
}
